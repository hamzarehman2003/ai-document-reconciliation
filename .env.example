# Copy this file to .env and fill in the values.

# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project URL (login). The API checks login tokens with the project's
# public keys, so no Supabase secret is needed here.
SUPABASE_URL=

# Local Postgres started by docker-compose.yml
DATABASE_URL=postgresql+psycopg://invoiceiq:invoiceiq@localhost:5432/invoiceiq
