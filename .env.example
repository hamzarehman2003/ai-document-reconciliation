# Copy this file to .env and fill in the values.

# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project URL (login). The API checks login tokens with the project's
# public keys, so no Supabase secret is needed here.
SUPABASE_URL=

# Key that n8n sends as X-API-Key to POST /api/webhooks/inbound (it can only upload).
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTAKE_API_KEY=

# Outgoing events (case.approved, case.needs_review) to an n8n Webhook node.
# Leave the URL empty to switch them off. The secret is sent as X-Webhook-Secret.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/invoiceiq-events
WEBHOOK_SECRET=

# Local Postgres started by docker-compose.yml
DATABASE_URL=postgresql+psycopg://invoiceiq:invoiceiq@localhost:5432/invoiceiq
