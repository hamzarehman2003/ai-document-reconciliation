# Copy this file to .env.local and fill in the values.

# Supabase project: Project Settings → Data API (URL) and → API Keys (publishable key).
# Both are public. Never put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: a shared demo account for the "Try the demo" button (leave empty to hide it).
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
