      "parameters": {
        "jsCode": "// One item per PDF attachment, with who sent it and the subject.\nconst out = [];\nfor (const email of $input.all()) {\n  for (const file of Object.values(email.binary ?? {})) {\n    const isPdf = file.mimeType === 'application/pdf'\n      || (file.fileName ?? '').toLowerCase().endsWith('.pdf');\n    if (isPdf) {\n      out.push({\n        json: { sender: email.json.from, subject: email.json.subject, fileName: file.fileName },\n        binary: { file },\n      });\n    }\n  }\n}\nreturn out;\n"
      },
